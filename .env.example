# =============================================================================
# TraFiSec (TraceGuard-DeFi) Environment Configuration
# =============================================================================

# Primary Ethereum Archive JSON-RPC Endpoint (Supports debug_traceTransaction / prestateTracer)
# Provider recommendation: Alchemy Growth or QuickNode Archive
ARCHIVE_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY_HERE

# Secondary Archive RPC (Used for cross-provider fidelity benchmarking in E5)
SECONDARY_ARCHIVE_RPC_URL=https://YOUR_QUICKNODE_ENDPOINT.quiknode.pro/YOUR_KEY/

# Local Anvil Fork Port & Settings
ANVIL_BIN=anvil
ANVIL_PORT=8545
ANVIL_UPSTREAM_TIMEOUT_MS=300000
ANVIL_UPSTREAM_RETRIES=3

# Evaluation & Dataset Paths
INCIDENTS_PATH=corpus/incidents.jsonl
VERIFIED_ATTACKS_PATH=corpus/verified_attacks.tsv
RESULTS_DIR=eval/results
RUNS_DIR=eval/results/runs

# Minimum Loss Threshold (L_min in USD) for Causal Necessity Attribution
L_MIN_USD=100000
